# Правила сжатия для релизной сборки.
#
# Flutter-приложение почти целиком живёт в Dart, и Java-кода здесь мало:
# движок, плагины и сгенерированный регистратор. Держим правила минимальными и
# добавляем сюда только то, что реально ломается, — каждое лишнее -keep
# обесценивает сжатие.

# Движок Flutter обращается к своим классам через JNI, поэтому имена не
# переименовываем.
-keep class io.flutter.** { *; }
-keep class io.flutter.plugins.** { *; }

# Аннотации нужны рефлексии плагинов.
-keepattributes *Annotation*

# Номера строк в отчётах о сбоях: без них стек нечитаем.
-keepattributes SourceFile,LineNumberTable
-renamesourcefileattribute SourceFile

# Движок Flutter ссылается на Play Core ради отложенной загрузки частей
# приложения. Мы её не используем, зависимости в проекте нет, и R8 честно
# сообщает о недостающих классах. Это не ошибка — код с этими ссылками никогда
# не выполнится, поэтому предупреждения глушим, а не тянем лишнюю библиотеку.
-dontwarn com.google.android.play.core.**
