<?xml version="1.0" encoding="utf-8"?>
<!--
  Адаптивная иконка для Android 8 и новее: систему интересуют два слоя, а форму
  она выбирает сама — круг, скруглённый квадрат или каплю. Поэтому фон здесь
  сплошной цвет, а не скруглённая плашка: скругление нарисует система.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background"/>
    <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
    <monochrome android:drawable="@mipmap/ic_launcher_foreground"/>
</adaptive-icon>
