<?xml version="1.0" encoding="utf-8"?>
<!--
  Открытый HTTP запрещён полностью: приложение отправляет пароли и токены, и
  для них незашифрованный канал недопустим. Это дублирует проверку в
  AppConfig — там сборка падает на старте, здесь запрет действует на уровне
  платформы, даже если проверку в коде когда-нибудь уберут.

  Отладочная сборка ходит на localhost по http, поэтому исключение живёт в
  отдельном файле для debug и в релиз не попадает.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false"/>
</network-security-config>
