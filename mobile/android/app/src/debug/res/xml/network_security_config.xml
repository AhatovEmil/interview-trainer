<?xml version="1.0" encoding="utf-8"?>
<!--
  Отладочный вариант: перекрывает основной файл только в debug-сборке.
  Открытый HTTP разрешён исключительно для локальной разработки — 10.0.2.2 это
  хост-машина изнутри эмулятора Android, 127.0.0.1 нужен для десктопных
  запусков. В релизную сборку этот файл не попадает.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false"/>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
