# --- Postgres (используется и контейнером postgres, и строкой подключения api) ---
POSTGRES_USER=trainer
POSTGRES_PASSWORD=trainer
POSTGRES_DB=trainer
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- Порты наружу ---
API_PORT=8000
NGINX_PORT=8080

# --- Приложение ---
ENVIRONMENT=local
DEBUG=false
LOG_LEVEL=INFO

# --- Аутентификация ---
# Значение ниже годится только для локальной разработки. В production приложение
# не стартует, пока SECRET_KEY не задан явно и не короче 32 байт:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-secret-change-me-before-deploy
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=30

# Строки подключения для ЛОКАЛЬНОГО запуска (без docker compose).
# Внутри compose эти значения перезаписываются на хосты postgres/redis.
DATABASE_URL=postgresql+asyncpg://trainer:trainer@localhost:5432/trainer
REDIS_URL=redis://localhost:6379/0

# --- Только для боевого развёртывания (docker-compose.prod.yml) ---
# Домен должен указывать на этот сервер: по нему Caddy выпускает сертификат,
# и проверка владения идёт через порты 80 и 443.
API_DOMAIN=api.example.com
# Почта для уведомлений Let's Encrypt об истечении сертификата.
ACME_EMAIL=admin@example.com
# Сколько дней хранить ежедневные копии базы.
BACKUP_KEEP_DAYS=14
