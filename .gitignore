# Flutter
/mobile/build/
/mobile/.dart_tool/
/mobile/.flutter-plugins*
/mobile/.packages
/mobile/pubspec.lock
# android/ и ios/ лежат в git: там applicationId, разрешения, настройки подписи
# и версия NDK — всё это часть проекта, а не артефакты сборки. Внутри каждого
# каталога свой .gitignore от Flutter, он отсекает build/, .gradle/ и ключи.
# Остальные платформы в MVP не поддерживаются и не генерируются.
/mobile/linux/
/mobile/macos/
/mobile/windows/
/mobile/web/
